#!/usr/bin/env bash
#
# pipeline-status — where am I in the review → issue → PR → merge pipeline?
#
# Prints a six-stage dashboard derived entirely from artifacts already on disk and
# on GitHub. There is no state file by design: a tracker drifts the moment you act
# outside the flow, artifacts can't.
#
# Full pipeline docs: ~/.claude/skills/WORKFLOW.md
#
# Usage:
#   pipeline-status          full dashboard
#   pipeline-status -n       offline: local artifacts only, no gh calls
#   pipeline-status -b       brief: just the recommended next command
#
# Deliberately read-only. It never runs a pipeline stage.

set -uo pipefail

OFFLINE=0
BRIEF=0
while getopts "nbh" opt; do
  case "$opt" in
    n) OFFLINE=1 ;;
    b) BRIEF=1 ;;
    h) awk 'NR>1 && /^#/ {sub(/^# ?/,""); print; next} NR>1 {exit}' "$0"; exit 0 ;;
    *) exit 2 ;;
  esac
done

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "not a git repository" >&2; exit 1
}
cd "$ROOT" || exit 1

# ---------------------------------------------------------------- portability

mtime() {  # epoch seconds of a file
  stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null
}

iso_epoch() {  # ISO-8601 (2026-07-28T14:32:00Z) -> epoch seconds
  date -j -u -f "%Y-%m-%dT%H:%M:%SZ" "${1%%+*}" +%s 2>/dev/null \
    || date -d "$1" +%s 2>/dev/null
}

age() {  # epoch seconds -> "3d ago"
  local d=$(( $(date +%s) - ${1:-0} ))
  (( d < 0 )) && d=0
  if   (( d < 3600  )); then echo "$((d/60))m ago"
  elif (( d < 86400 )); then echo "$((d/3600))h ago"
  else                       echo "$((d/86400))d ago"; fi
}

newest() {  # newest matching file, or empty
  ls -t $1 2>/dev/null | head -1
}

row() {  # stage number, label, body
  printf '  %s %-11s %s\n' "$1" "$2" "$3"
}

# ---------------------------------------------------------------- gh, in parallel

HAS_GH=0
if [[ $OFFLINE -eq 0 ]] && command -v gh >/dev/null 2>&1 \
   && command -v jq >/dev/null 2>&1 \
   && git remote -v 2>/dev/null | grep -q github.com; then
  HAS_GH=1
elif [[ $OFFLINE -eq 0 ]] && command -v gh >/dev/null 2>&1 \
   && ! command -v jq >/dev/null 2>&1; then
  GH_ERR="jq not installed — local artifacts only (brew install jq)"
fi

TMP=$(mktemp -d) || exit 1
trap 'rm -rf "$TMP"' EXIT

if [[ $HAS_GH -eq 1 ]]; then
  gh issue list --state open --limit 300 \
     --json number,labels,updatedAt > "$TMP/issues" 2>"$TMP/err" &
  gh pr list --state open --limit 100 \
     --json number,title,mergeable,body,closingIssuesReferences > "$TMP/prs" 2>/dev/null &
  gh pr list --state merged --limit 30 \
     --json number,mergedAt > "$TMP/merged" 2>/dev/null &
  wait
  # A single failure (auth, rate limit, no such repo) downgrades to offline
  # rather than printing half a dashboard of zeros.
  if [[ -s "$TMP/err" ]] || [[ ! -s "$TMP/issues" ]]; then
    HAS_GH=0
    GH_ERR=$(head -1 "$TMP/err" 2>/dev/null)
  fi
fi

# ---------------------------------------------------------------- stage 1: reviews

PR_REVIEW="docs/reviews/PROJECT_REVIEW.md"
# PR-mode and change-mode reports (code-review_PR68_*.md, code-review_CHANGE-*.md) are
# excluded: they review an unmerged branch
# at stage 6, not this repo's code at stage 1. Counting one as "there is a current
# review" would report the work as found when nothing has been reviewed on HEAD at all.
CR_REVIEW=$(ls -t docs/reviews/code-review_*.md 2>/dev/null \
            | grep -v -e '/code-review_PR[0-9]\{1,\}_' -e '/code-review_CHANGE-' | head -1)
REVIEW_LINES=()
REVIEW_STALE=0
REVIEW_BEHIND=0

if [[ -f $PR_REVIEW ]]; then
  m=$(mtime "$PR_REVIEW")
  REVIEW_BEHIND=$(git rev-list --count --since="@$m" HEAD 2>/dev/null || echo 0)
  note=""
  if [[ ${REVIEW_BEHIND:-0} -gt 0 ]]; then
    note="  ·  $REVIEW_BEHIND commits since  [stale]"; REVIEW_STALE=1
  fi
  REVIEW_LINES+=("PROJECT_REVIEW.md  $(age "$m")$note")
fi
if [[ -n $CR_REVIEW ]]; then
  m=$(mtime "$CR_REVIEW")
  REVIEW_LINES+=("$(basename "$CR_REVIEW")  $(age "$m")")
fi

# ---------------------------------------------------------------- stage 2: issues

# An issue is incomplete until /issue-triage has given it the labels /fix-order ranks
# by. The fingerprint is part of "complete" too, but it lives in a comment, and one
# gh call per issue is too slow for a dashboard -- so only the labels are checked.
# This is the stage-2 gate for issues from every source: /make-issues, /to-tickets,
# or a person.
ISSUES_OPEN=0; ISSUES_FROM_REVIEW=0; ISSUES_INCOMPLETE=0
if [[ $HAS_GH -eq 1 ]]; then
  ISSUES_OPEN=$(jq -r 'length' < "$TMP/issues" 2>/dev/null || echo 0)
  ISSUES_FROM_REVIEW=$(jq -r '
    [ .[] | select(.labels | map(.name) | any(startswith("source: "))) ] | length
  ' < "$TMP/issues" 2>/dev/null || echo 0)
  ISSUES_INCOMPLETE=$(jq -r '
    [ .[] | (.labels | map(.name)) as $l
          | select(($l | any(startswith("severity: ")) | not)
                or ($l | any(startswith("effort: ")) | not)) ] | length
  ' < "$TMP/issues" 2>/dev/null || echo 0)
fi

# ---------------------------------------------------------------- stage 3: fix-order

FO_DIR=".claude/tmp/fix-order"
FO_FILE=$(newest "$FO_DIR/*.md")
FO_UNITS=0; FO_DECIDE=0; FO_AGE=""; FO_STALE=0
if [[ -n $FO_FILE ]]; then
  m=$(mtime "$FO_FILE")
  FO_UNITS=$(grep -c '^  - order:' "$FO_FILE" 2>/dev/null || echo 0)
  FO_DECIDE=$(grep -c 'disposition: NEEDS-DECISION' "$FO_FILE" 2>/dev/null || echo 0)
  FO_AGE=$(age "$m")
  # An issue that changed after the snapshot (a decision answered, a summary or
  # label added by /issue-triage, a new issue) makes the order out of date.
  if [[ $HAS_GH -eq 1 ]]; then
    last=$(jq -r 'map(.updatedAt) | sort | last // empty' < "$TMP/issues" 2>/dev/null)
    if [[ -n $last ]]; then
      e=$(iso_epoch "$last")
      [[ -n $e && $e -gt $m ]] && FO_STALE=1
    fi
  fi
fi

# ---------------------------------------------------------------- stage 4: in flight

BRANCHES=$(git branch -a 2>/dev/null | grep -cE 'Fix-I[0-9]+' || true)
PRS_OPEN=0; PRS_CONFLICT=0
if [[ $HAS_GH -eq 1 ]]; then
  PRS_OPEN=$(jq -r 'length' < "$TMP/prs" 2>/dev/null || echo 0)
  PRS_CONFLICT=$(jq -r '[ .[] | select(.mergeable=="CONFLICTING") ] | length' \
    < "$TMP/prs" 2>/dev/null || echo 0)
fi

# Open issues with no branch and no PR that closes them — the stage-4 backlog.
# A branch counts when its name carries I<n> (Fix-I60-..., Fix-I11-I15-...). A PR
# counts when it closes the issue, whatever its branch name, so a PR from
# /implement-spec counts too. Issues with a deferral label are left out: /fix-order
# and /work-issue exclude them, so they are not work that waits to start.
UNSTARTED=0
if [[ $HAS_GH -eq 1 ]]; then
  branches=$(git branch -a 2>/dev/null)
  closed_by_pr=$(jq -r '.[].closingIssuesReferences[]?.number' < "$TMP/prs" 2>/dev/null)
  for n in $(jq -r '
      .[] | select(.labels | map(.name | ascii_downcase)
                   | any(test("^(backlog|icebox|someday|someday-maybe|future|deferred|on hold|wontfix)$")
                         or test("[/:] ?backlog$")) | not)
          | .number' < "$TMP/issues" 2>/dev/null); do
    grep -qE "(^|-)I${n}(-|$)" <<<"$branches" && continue
    grep -qx "$n" <<<"$closed_by_pr" && continue
    UNSTARTED=$((UNSTARTED+1))
  done
fi

# ---------------------------------------------------------------- stage 5: merge-order

MO_DIR=".claude/tmp/merge-order"
MO_FILE=$(newest "$MO_DIR/*.md")
MO_COUNT=0; MO_AGE=""; MO_TOP=""; MO_STALE=0
if [[ -n $MO_FILE ]]; then
  m=$(mtime "$MO_FILE")
  MO_COUNT=$(grep -c '^  - number:' "$MO_FILE" 2>/dev/null || echo 0)
  MO_TOP=$(grep -m1 '^  - number:' "$MO_FILE" 2>/dev/null | tr -dc '0-9')
  MO_AGE=$(age "$m")
  if [[ $HAS_GH -eq 1 ]]; then
    last=$(jq -r 'map(.mergedAt) | sort | last // empty' < "$TMP/merged" 2>/dev/null)
    if [[ -n $last ]]; then
      e=$(iso_epoch "$last")
      [[ -n $e && $e -gt $m ]] && MO_STALE=1
    fi
  fi
fi

# ------------------------------------------------- stacked PRs awaiting a restack
# A child PR whose parent has merged needs `/work-issue restack` before it can be
# merged itself -- otherwise its diff still carries the parent's commits. Counted
# precisely: an unresolved marker whose own parent_pr shows up in $TMP/merged.
# $TMP/prs (with body) and $TMP/merged are already on disk from the parallel gh
# calls above, so this costs no extra `gh` call.
RESTACK_NEEDED=0
if [[ $HAS_GH -eq 1 ]]; then
  merged_json=$(cat "$TMP/merged" 2>/dev/null)
  [[ -z $merged_json ]] && merged_json='[]'
  RESTACK_NEEDED=$(jq -r --argjson merged "$merged_json" '
    ($merged | map(.number)) as $merged_nums
    | [ .[] | select(.body != null)
            | select(.body | test("<!-- work-issue-stack"))
            | select(.body | test("resolved:\\s*true") | not)
            | (.body | capture("parent_pr:\\s*(?<n>[0-9]+)").n | tonumber) as $p
            | select($merged_nums | index($p)) ] | length
  ' < "$TMP/prs" 2>/dev/null || echo 0)
fi

# ---------------------------------------------------------------- stage 6: merged

MERGED=0
[[ $HAS_GH -eq 1 ]] && MERGED=$(jq -r 'length' < "$TMP/merged" 2>/dev/null || echo 0)

# ---------------------------------------------------------------- next step

next_step() {
  if [[ $HAS_GH -eq 0 ]]; then
    if [[ ${#REVIEW_LINES[@]} -eq 0 ]]; then
      echo "/project-review  —  no review report in docs/reviews/ yet"
    else
      echo "work the findings in ${REVIEW_LINES[0]%% *} directly  —  no GitHub remote, stages 2-5 don't apply"
    fi
    return
  fi
  if [[ ${#REVIEW_LINES[@]} -eq 0 && $ISSUES_OPEN -eq 0 ]]; then
    echo "/project-review  —  nothing filed and no review to file from"
    echo "     (or, to build an idea: /grill-with-docs, then /to-spec and /to-tickets)"; return
  fi
  # A report far behind HEAD cites line numbers that have drifted. Filing from it
  # produces issues pointing at the wrong code, so re-review beats re-file.
  if [[ $ISSUES_FROM_REVIEW -eq 0 && $REVIEW_BEHIND -ge 10 ]]; then
    echo "/project-review  —  the report is $REVIEW_BEHIND commits behind HEAD; re-run it before filing findings with drifted line numbers"
    return
  fi
  if [[ $ISSUES_FROM_REVIEW -eq 0 && ${#REVIEW_LINES[@]} -gt 0 ]]; then
    s=""; [[ $REVIEW_BEHIND -gt 0 ]] && s=" (report is $REVIEW_BEHIND commits behind; /make-issues will flag drifted findings)"
    echo "/make-issues  —  a review exists but no issues carry a source: label$s"; return
  fi
  # The gate comes before the order: /fix-order ranks an incomplete issue last and
  # guesses nothing for it, so an order made first is an order made blind.
  if [[ $ISSUES_INCOMPLETE -gt 0 ]]; then
    echo "/issue-triage  —  $ISSUES_INCOMPLETE open issue(s) have no severity: or effort: label; /fix-order ranks them last until then"
    return
  fi
  if [[ $FO_DECIDE -gt 0 && $FO_STALE -eq 1 ]]; then
    echo "/fix-order  —  issues changed after the snapshot; re-run it before you act on its $FO_DECIDE NEEDS-DECISION"
    return
  fi
  if [[ $FO_DECIDE -gt 0 ]]; then
    echo "answer the $FO_DECIDE NEEDS-DECISION issue(s) in $FO_FILE, then re-run /fix-order"
    echo "     (/work-issue all halts on them until then)"; return
  fi
  if [[ $ISSUES_OPEN -gt 0 && -z $FO_FILE ]]; then
    echo "/fix-order  —  $ISSUES_OPEN open issues, never ordered"; return
  fi
  if [[ $UNSTARTED -gt 0 ]]; then
    echo "/work-issue all  —  $UNSTARTED open issue(s) with no branch or PR"; return
  fi
  if [[ $PRS_OPEN -ge 2 && ( -z $MO_FILE || $MO_STALE -eq 1 ) ]]; then
    s="no merge order yet"; [[ -n $MO_FILE ]] && s="merge order is stale"
    echo "/merge-order  —  $PRS_OPEN PRs open, $s"
    return
  fi
  if [[ ${RESTACK_NEEDED:-0} -gt 0 ]]; then
    echo "/work-issue restack  —  $RESTACK_NEEDED stacked PR(s) whose parent has merged need restacking before they can merge"
    return
  fi
  if [[ $PRS_OPEN -ge 1 && -n $MO_TOP ]]; then
    echo "review and merge #$MO_TOP, then re-run /merge-order  —  every merge invalidates the rest of the order"
    [[ -z $(newest "docs/reviews/code-review_PR${MO_TOP}_*.md") ]] &&
      echo "     (/code-review $MO_TOP for the line-level pass first — it has no review report yet)"
    return
  fi
  if [[ $PRS_OPEN -eq 1 ]]; then
    echo "review and merge the open PR  —  a queue of one needs no triage"; return
  fi
  if [[ $REVIEW_STALE -eq 1 ]]; then
    echo "/project-review  —  queue is empty and the last review is stale; start the next round"; return
  fi
  echo "nothing pending  —  /project-review or /code-review <scope> to start the next round"
}

# ---------------------------------------------------------------- output

if [[ $BRIEF -eq 1 ]]; then
  echo "next: $(next_step)"
  exit 0
fi

branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
echo
echo "  $(basename "$ROOT")  ($branch)"
[[ $HAS_GH -eq 0 ]] && echo "  ${GH_ERR:-offline — local artifacts only}"
echo

if [[ ${#REVIEW_LINES[@]} -eq 0 ]]; then
  row 1 review "—"
else
  row 1 review "${REVIEW_LINES[0]}"
  for ((i=1; i<${#REVIEW_LINES[@]}; i++)); do row " " "" "${REVIEW_LINES[$i]}"; done
fi

if [[ $HAS_GH -eq 1 ]]; then
  s=""; [[ $ISSUES_INCOMPLETE -gt 0 ]] && s="  ·  $ISSUES_INCOMPLETE incomplete"
  row 2 issues "$ISSUES_OPEN open  ·  $ISSUES_FROM_REVIEW from a review report$s"
else
  row 2 issues "—"
fi

if [[ -n $FO_FILE ]]; then
  d=""; [[ $FO_DECIDE -gt 0 ]] && d="  ·  $FO_DECIDE NEEDS-DECISION  <- blocked on you"
  s=""; [[ $FO_STALE -eq 1 ]] && s="  [stale: an issue changed since]"
  row 3 fix-order "$(basename "$FO_FILE")  $FO_AGE  ·  $FO_UNITS units$d$s"
else
  row 3 fix-order "—"
fi

row 4 "in flight" "$BRANCHES branches  ·  $PRS_OPEN PRs open$( [[ $PRS_CONFLICT -gt 0 ]] && echo "  ·  $PRS_CONFLICT CONFLICTING" )"

if [[ -n $MO_FILE ]]; then
  s=""; [[ $MO_STALE -eq 1 ]] && s="  [stale: a PR merged since]"
  row 5 "merge order" "$(basename "$MO_FILE")  $MO_AGE  ·  $MO_COUNT PRs$s"
else
  row 5 "merge order" "—"
fi

row 6 merged "$( [[ $HAS_GH -eq 1 ]] && echo "$MERGED PRs (last 30)" || echo "—" )"

echo
echo "  next: $(next_step)"
echo
